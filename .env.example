# Unified AI Cybersecurity Agent - Environment Configuration
# ₹0 API & Software Budget Edition

# Core Networking
WEB_PORT=8080
DNS_PORT=5353
QUAD9_DOH=https://dns.quad9.net/dns-query

# AI Model Provider (Options: groq, gemini, openrouter, ollama, offline)
AI_PROVIDER=groq
AI_API_KEY=gsk_your_groq_free_key_here

# Optional: Google Gemini Flash
# AI_PROVIDER=gemini
# AI_API_KEY=AIzaSy...

# Optional: Local Ollama Endpoint (100% Offline Private)
# AI_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434

# Optional: Wazuh Manager REST API (:55000)
# If unconfigured, agent operates in native standalone security mode
WAZUH_HOST=https://127.0.0.1:55000
WAZUH_USER=wazuh-wui
WAZUH_PASS=

# Optional: VirusTotal v3 Live Multi-Engine
VT_API_KEY=

# Authorized Assessment Targets (Comma-Separated Hostnames / IPs)
# Scans strictly blocked if target is not on this list
ALLOWED_TARGETS=localhost, 127.0.0.1, ::1, example.com, scanme.nmap.org

# Session & Security Settings
SESSION_SECRET=cyber_sec_token_secret_replace_in_prod
RATE_LIMIT_REQ_PER_MIN=120
NIGHTLY_DISPATCH_TIME=21:00
